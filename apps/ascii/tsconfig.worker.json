{
  "compilerOptions": {
    "target": "ES2020",
    // The service worker's own scope. `WebWorker` and `DOM` cannot both be in one project — they
    // declare the same globals with different types — which is the whole reason this file exists.
    "lib": ["ES2020", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/pwa/service-worker.ts", "src/pwa/policy.ts"]
}
